+++ b/scripts/restore_binaries.py
@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+"""Restore binary artifacts from the base64 text recovery bundle.
+
+The Arena UI can only export TEXT patches from a closed session's sandbox —
+binaries (MP3) would be lost. The recovery bundle (legacy/source/binary_recovery/)
+carries each new MP3 as base64 text so it survives any text-only channel.
+
+Two recovery paths exist (either is sufficient):
+1. THIS SCRIPT — decode base64 back to bytes and verify sha256 (fast, exact).
+2. Deterministic re-render — recipes are text and render_jingle.py is
+   byte-deterministic (LESSONS 2026-09-22), so the MP3s can also be regenerated:
+       python scripts/render_jingle.py data/recipes/5_v4.json \
+           --out legacy/source/jingle_output/5_v4.mp3 --min-score 85
+   (stems wolf_howl/steam_vent are already on main from PR #12).
+
+Usage:
+  python scripts/restore_binaries.py            # decode + verify, overwrite missing files
+  python scripts/restore_binaries.py --check    # only verify existing files
+"""
+from __future__ import annotations
+
+import argparse
+import base64
+import hashlib
+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+RECOVERY = ROOT / "legacy/source/binary_recovery"
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--check", action="store_true", help="tylko weryfikacja, bez zapisu")
+    args = parser.parse_args()
+
+    manifest = json.loads((RECOVERY / "manifest.json").read_text(encoding="utf-8"))
+    failures = 0
+    for entry in manifest:
+        target = ROOT / entry["file"]
+        expected = entry["sha256"]
+        if args.check:
+            if not target.is_file():
+                print(f"BRAK   {entry['file']}")
+                failures += 1
+                continue
+            digest = hashlib.sha256(target.read_bytes()).hexdigest()
+            ok = digest == expected
+            print(f"{'OK  ' if ok else 'ZŁY '} {entry['file']} ({digest[:12]}…)")
+            failures += 0 if ok else 1
+            continue
+        blob = base64.b64decode("".join((RECOVERY / Path(entry["b64"]).name).read_text(encoding="ascii").split()))
+        digest = hashlib.sha256(blob).hexdigest()
+        if digest != expected:
+            print(f"BŁĄD sha256 dla {entry['file']} — paczka uszkodzona")
+            failures += 1
+            continue
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(blob)
+        print(f"odtworzono {entry['file']} ({len(blob)} B, sha256 OK)")
+    if failures:
+        print(f"\n{failures} problem(ów).", )
+        return 1
+    print("\nWszystkie binaria zgodne (sha256).")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
