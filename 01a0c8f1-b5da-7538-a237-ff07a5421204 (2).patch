diff --git a/.github/workflows/sample-scout.yml b/.github/workflows/sample-scout.yml
new file mode 100644
index 0000000..c49c1bf
--- /dev/null
+++ b/.github/workflows/sample-scout.yml
@@ -0,0 +1,67 @@
+name: Sample scout
+
+# Downloader community-ranked sampli z Freesound (CC0, sortowanie po ocenach
+# społeczności). Runner GitHub Actions ma pełny internet — sandbox Arena nie
+# (patrz docs/sources-and-licensing.md). Kandydaci wracają do repo przez
+# commit bota, a agent w sandboxie pobiera je przez git pull z github.com.
+#
+# Jednorazowa konfiguracja właściciela: konto freesound.org → klucz API
+# (https://freesound.org/apiv2/apply) → sekret Actions FREESOUND_TOKEN.
+#
+# Uruchomienie (właściciel z zakładki Actions LUB agent: gh workflow run
+# sample-scout.yml -f query="wolf howl" -f count=5 -f sort=rating_desc).
+
+on:
+  workflow_dispatch:
+    inputs:
+      source:
+        description: 'Źródło: freesound | archive.org'
+        required: false
+        default: 'freesound'
+      query:
+        description: 'Zapytanie, np. "wolf howl"'
+        required: true
+      count:
+        description: 'Ilu kandydatów pobrać (top wg wybranego sortowania)'
+        required: false
+        default: '5'
+      sort:
+        description: 'Sortowanie: rating_desc | downloads_desc | score'
+        required: false
+        default: 'rating_desc'
+
+permissions:
+  contents: write
+
+concurrency:
+  group: sample-scout
+  cancel-in-progress: true
+
+jobs:
+  scout:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - name: Fetch community-ranked candidates
+        env:
+          FREESOUND_TOKEN: ${{ secrets.FREESOUND_TOKEN }}
+        run: |
+          python scripts/sample_scout.py \
+            --query "${{ inputs.query }}" \
+            --count "${{ inputs.count }}" \
+            --sort "${{ inputs.sort }}" \
+            --out legacy/source/sample_scout
+      - name: Commit candidates
+        run: |
+          git config user.name "sample-scout-bot"
+          git config user.email "actions@users.noreply.github.com"
+          git add legacy/source/sample_scout
+          if git diff --cached --quiet; then
+            echo "Brak nowych plików — nic do commitowania."
+          else
+            git commit -m "Sample scout: \"${{ inputs.query }}\" (${{ inputs.count }} kandydatów, sort=${{ inputs.sort }}) [skip ci]"
+            git push
+          fi
