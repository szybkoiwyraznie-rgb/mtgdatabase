@@ -0,0 +1,196 @@
+#!/usr/bin/env python3
+"""Sample Scout: fetch community-ranked sound candidates from Freesound / Internet Archive.
+
+Runs INSIDE GitHub Actions (the runner has unrestricted internet; the Arena
+sandbox does not — see docs/sources-and-licensing.md). The next-session agent
+triggers `.github/workflows/sample-scout.yml` with a query; this script asks
+the chosen source for CC0 sounds, sorts by COMMUNITY metrics (Freesound:
+avg rating; Internet Archive: downloads), downloads top-N files and writes a
+manifest with the community stats. Candidates land in the repo and come back
+to the sandbox via git — so the agent can pick the best sample itself.
+
+Stdlib only (urllib) — no pip install needed in CI.
+
+Usage (from the workflow):
+  FREESOUND_TOKEN=... python scripts/sample_scout.py \
+      --source freesound --query "wolf howl" --count 5 --sort rating_desc \
+      --out legacy/source/sample_scout
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import urllib.parse
+import urllib.request
+from pathlib import Path
+
+UA = {"User-Agent": "mtgdatabase-sample-scout/1.0 (private project)"}
+SORTS = ("rating_desc", "downloads_desc", "score")
+CC0_URL_MARKER = "publicdomain/zero"
+
+
+def http_get(url: str, token: str | None = None, timeout: int = 30) -> bytes:
+    headers = dict(UA)
+    if token:
+        headers["Authorization"] = f"Token {token}"
+    with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=timeout) as resp:
+        return resp.read()
+
+
+def slugify(text: str) -> str:
+    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:48] or "query"
+
+
+def is_cc0(license_field: str | None) -> bool:
+    """Freesound zwraca nazwę licencji, IA pole licenseurl."""
+    if not license_field:
+        return False
+    value = str(license_field).lower()
+    return "creative commons 0" in value or CC0_URL_MARKER in value
+
+
+# --------------------------------------------------------------------------
+# Connector: Freesound (oceny społeczności: avg_rating, num_ratings, downloads)
+# --------------------------------------------------------------------------
+def fetch_freesound(query: str, count: int, sort: str, token: str) -> list[dict]:
+    params = urllib.parse.urlencode({
+        "query": query,
+        "filter": 'license:"Creative Commons 0"',
+        "sort": sort,
+        "page_size": count,
+        "fields": "id,name,username,license,duration,avg_rating,num_ratings,downloads,comments,previews,url",
+    })
+    data = json.loads(http_get(f"https://freesound.org/apiv2/search/text/?{params}", token))
+    manifest = []
+    for item in data.get("results", []):
+        preview = (item.get("previews") or {}).get("preview-hq-mp3")
+        if not preview:
+            continue
+        yield_item = {
+            "source": "freesound",
+            "url": preview,
+            "freesound_id": item["id"],
+            "name": item["name"],
+            "author": item["username"],
+            "license": "CC0 1.0 (Creative Commons Zero)",
+            "source_url": item["url"],
+            "duration_sec": item.get("duration"),
+            "avg_rating": item.get("avg_rating"),
+            "num_ratings": item.get("num_ratings"),
+            "downloads": item.get("downloads"),
+            "comments": item.get("comments"),
+        }
+        manifest.append(yield_item)
+    return manifest
+
+
+# --------------------------------------------------------------------------
+# Connector: Internet Archive (metryki społeczności: downloads; kolekcje SFX CC0)
+# --------------------------------------------------------------------------
+def fetch_archiveorg(query: str, count: int) -> list[dict]:
+    params = urllib.parse.urlencode({
+        "q": f"({query}) AND mediatype:(audio)",
+        "fl[]": ["identifier", "title", "creator", "downloads", "licenseurl"],
+        "rows": count * 3,  # odfiltrujemy nie-CC0 po stronie klienta
+        "sort[]": "downloads desc",
+        "output": "json",
+    }, doseq=True)
+    data = json.loads(http_get(f"https://archive.org/advancedsearch.php?{params}"))
+    docs = (data.get("response") or {}).get("docs", [])
+    manifest: list[dict] = []
+    for doc in docs:
+        if not is_cc0(doc.get("licenseurl")) or len(manifest) >= count:
+            continue
+        identifier = doc["identifier"]
+        try:
+            meta = json.loads(http_get(f"https://archive.org/metadata/{identifier}"))
+        except Exception as error:
+            print(f"skip {identifier}: metadata ({error})")
+            continue
+        # wybierz pierwszy sensowny mp3 (krótsze pliki = łatwiejszy stem)
+        files = [f for f in meta.get("files", []) if str(f.get("format", "")).lower().startswith("mp3")]
+        files.sort(key=lambda f: float(f.get("size", 1e12) or 1e12))
+        picked = None
+        for candidate in files:
+            size = float(candidate.get("size") or 0)
+            if 50_000 <= size <= 12_000_000:
+                picked = candidate
+                break
+        if not picked:
+            continue
+        name = picked["name"].rsplit("/", 1)[-1]
+        manifest.append({
+            "source": "archive.org",
+            "url": f"https://archive.org/download/{identifier}/{urllib.parse.quote(picked['name'])}",
+            "identifier": identifier,
+            "file": name,
+            "name": f"{doc.get('title', identifier)} — {name}",
+            "author": doc.get("creator"),
+            "license": "CC0 1.0 (public domain dedication)",
+            "source_url": f"https://archive.org/details/{identifier}",
+            "downloads": doc.get("downloads"),
+            "avg_rating": None,
+            "num_ratings": None,
+            "note": "IA nie ma ocen gwiazdkowych — ranking wg liczby pobrań społeczności",
+        })
+    return manifest
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--source", choices=("freesound", "archive.org"), default="freesound")
+    parser.add_argument("--query", required=True, help='np. "wolf howl" / "sound effects wolf"')
+    parser.add_argument("--count", type=int, default=5, help="ilu najlepszych kandydatów pobrać")
+    parser.add_argument("--sort", choices=SORTS, default="rating_desc",
+                        help="ranking (Freesound: rating_desc/downloads_desc; IA: zawsze downloads)")
+    parser.add_argument("--out", type=Path, default=Path("legacy/source/sample_scout"))
+    args = parser.parse_args()
+
+    if args.source == "freesound":
+        token = os.environ.get("FREESOUND_TOKEN", "").strip()
+        if not token:
+            print("Brak FREESOUND_TOKEN. Jednorazowa konfiguracja: konto na freesound.org →",
+                  "https://freesound.org/apiv2/apply → sekret Actions FREESOUND_TOKEN.", file=__import__("sys").stderr)
+            return 2
+        manifest = fetch_freesound(args.query, args.count, args.sort, token)
+    else:
+        manifest = fetch_archiveorg(args.query, args.count)
+
+    if not manifest:
+        print(f"{args.source}: brak kandydatów CC0 dla '{args.query}'.", file=__import__("sys").stderr)
+        return 1
+
+    out_dir = args.out / f"{args.source}_{slugify(args.query)}"
+    out_dir.mkdir(parents=True, exist_ok=True)
+    saved = []
+    for item in manifest:
+        name = f"{slugify(item['name'])}.mp3"
+        target = out_dir / name
+        try:
+            blob = http_get(item.pop("url"))
+            if len(blob) < 2000:
+                raise ValueError(f"podejrzanie mały plik ({len(blob)} B)")
+            target.write_bytes(blob)
+        except Exception as error:
+            print(f"skip {name}: {error}")
+            continue
+        item["file"] = str(target)
+        saved.append(item)
+        stats = f"ocena {item.get('avg_rating')} ({item.get('num_ratings')} ocen)" if item.get("avg_rating") \
+            else f"{item.get('downloads')} pobrań"
+        print(f"pobrano {name} — {stats}")
+
+    if not saved:
+        print("Nie udało się pobrać żadnego kandydata.", file=__import__("sys").stderr)
+        return 1
+    (out_dir / "manifest.json").write_text(json.dumps(saved, ensure_ascii=False, indent=2), encoding="utf-8")
+    print(f"\nManifest: {out_dir / 'manifest.json'} ({len(saved)} kandydatów, {args.source}).")
+    print("Agent wybiera nr 1 wg metryk społeczności + własnej kontroli (długość/piki), "
+          "rejestruje w data/sources.json i renderuje JEDNĄ wersję do oceny.")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
